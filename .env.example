BOT_TOKEN=
ADMIN_IDS=

TEMP_DIR=temp_downloads
STATS_DB_PATH=database.db
COOKIES_FILE=cookies.txt
LOG_FILE=bot.log
LOG_LEVEL=INFO

MAX_CONCURRENT_DOWNLOADS=2
MAX_QUEUE_SIZE=100
MAX_TASKS_PER_USER=10
MAX_PLAYLIST_ITEMS=25
MAX_FILE_SIZE=52428800
SEND_AS_DOC_LIMIT=52428800
DOWNLOAD_TIMEOUT_SECONDS=1800
DOWNLOAD_STALL_TIMEOUT_SECONDS=180
DOWNLOAD_RATE_LIMIT_BYTES=0
PROGRESS_UPDATE_SECONDS=3
SELECTION_TTL_SECONDS=900

# Enable these values only when telegram-bot-api runs locally.
BOT_API_BASE_URL=
BOT_API_IS_LOCAL=false
# true only when bot and telegram-bot-api share the same filesystem
BOT_API_USE_FILE_URI=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Alwaysdata API token used by scripts/update_and_restart_alwaysdata.sh
# Keep this secret only in the server .env; never commit the real value.
ALWAYSDATA_API_TOKEN=
